#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

echo "=========================================================="
echo " Starting CodeSkill Piston Bootstrap (Cloud Map Discovery) "
echo " Architecture: $(uname -m), Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "=========================================================="

REGION="${aws_region}"
CLOUD_MAP_SERVICE_ID="${piston_service_id}"

# 1. Install Docker & AWS CLI
if command -v dnf &>/dev/null; then
  dnf install -y --allowerasing docker aws-cli jq
  systemctl enable --now docker
elif command -v apt-get &>/dev/null; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y docker.io awscli curl jq
  systemctl enable --now docker
fi

systemctl enable --now amazon-ssm-agent || true

# 2. Get Private IP and Instance ID via IMDSv2
TOKEN=$(curl -s -S -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -S -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
PRIVATE_IP=$(curl -s -S -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

echo "Instance ID: $INSTANCE_ID, Private IP: $PRIVATE_IP"

# 3. Pull and Launch Piston Container
PISTON_IMAGE="${piston_image}"
if [ -z "$PISTON_IMAGE" ] || [ "$PISTON_IMAGE" = "none" ]; then
  echo "An approved piston image is required" >&2
  exit 1
fi
ECR_REGISTRY="${ecr_registry}"
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
docker pull "$PISTON_IMAGE"

mkdir -p /var/lib/piston/packages /var/lib/piston/jobs

cat << EOF > /etc/systemd/system/codeskill-piston.service
[Unit]
Description=CodeSkill Piston Isolated Execution Engine
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker stop codeskill-piston
ExecStartPre=-/usr/bin/docker rm codeskill-piston
ExecStart=/usr/bin/docker run --rm --name codeskill-piston \\
  -p 2001:2000 \\
  -v /var/lib/piston:/piston \\
  --privileged \\
  --pids-limit 1024 \\
  -e PISTON_MAX_CONCURRENT_JOBS=10 \\
  -e PISTON_RUN_TIMEOUT=8000 \\
  -e PISTON_COMPILE_TIMEOUT=10000 \\
  -e PISTON_RUN_CPU_TIME=8000 \\
  -e PISTON_COMPILE_CPU_TIME=10000 \\
  -e PISTON_RUN_MEMORY_LIMIT=536870912 \\
  -e PISTON_COMPILE_MEMORY_LIMIT=536870912 \\
  -e PISTON_OUTPUT_MAX_SIZE=65536 \\
  -e PISTON_MAX_PROCESS_COUNT=64 \\
  -e PISTON_MAX_OPEN_FILES=128 \\
  -e PISTON_MAX_FILE_SIZE=10000000 \\
  $PISTON_IMAGE
ExecStop=/usr/bin/docker stop -t 15 codeskill-piston

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now codeskill-piston.service

# 4. Wait for Piston API readiness
READY=false
for i in {1..30}; do
  if curl -sf http://127.0.0.1:2001/api/v2/runtimes >/dev/null 2>&1; then
    READY=true
    echo "Piston ready on port 2001."
    break
  fi
  sleep 3
done

if [ "$READY" != true ]; then echo "Piston readiness probe failed" >&2; exit 1; fi

# 4b. Pre-provision required language packages into Piston
echo "Installing Piston language runtimes..."
for pkg in \
  '{"language":"python","version":"3.10.0"}' \
  '{"language":"gcc","version":"10.2.0"}' \
  '{"language":"node","version":"18.15.0"}' \
  '{"language":"typescript","version":"5.0.3"}' \
  '{"language":"java","version":"15.0.2"}'; do
  curl -s -X POST http://127.0.0.1:2001/api/v2/packages \
    -H "Content-Type: application/json" \
    -d "$pkg" || true
done

# 4c. Optimize Java runner (Tier 1 C1 compilation + Serial GC for fast boot)
if [ -f /var/lib/piston/packages/java/15.0.2/run ]; then
  sed -i 's|^java |java -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xms16m -Xmx384m |g' /var/lib/piston/packages/java/15.0.2/run
fi

# 5. Register with AWS Cloud Map Private DNS Service
if [ -n "$CLOUD_MAP_SERVICE_ID" ]; then
  echo "Registering $INSTANCE_ID ($PRIVATE_IP) with Cloud Map Service $CLOUD_MAP_SERVICE_ID..."
  aws servicediscovery register-instance \
    --service-id "$CLOUD_MAP_SERVICE_ID" \
    --instance-id "$INSTANCE_ID" \
    --attributes AWS_INSTANCE_IPV4="$PRIVATE_IP",AWS_INSTANCE_PORT=2001 \
    --region "$REGION"
fi

# 6. Configure Deregistration Hook on Shutdown
cat << 'EOF' > /usr/local/bin/deregister-cloudmap.sh
#!/bin/bash
TOKEN=$(curl -s -S -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || true)
INSTANCE_ID=$(curl -s -S -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null || true)
if [ -n "$INSTANCE_ID" ]; then
  aws servicediscovery deregister-instance --service-id "${piston_service_id}" --instance-id "$INSTANCE_ID" --region "${aws_region}" || true
fi
EOF
chmod +x /usr/local/bin/deregister-cloudmap.sh

cat << 'EOF' > /etc/systemd/system/deregister-cloudmap.service
[Unit]
Description=Deregister Piston Instance from AWS Cloud Map on Shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/deregister-cloudmap.sh
TimeoutSec=20

[Install]
WantedBy=shutdown.target reboot.target halt.target
EOF

systemctl daemon-reload
systemctl enable deregister-cloudmap.service

echo "CodeSkill Piston bootstrap complete at $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
