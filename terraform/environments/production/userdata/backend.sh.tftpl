#!/usr/bin/env bash
set -euo pipefail
umask 077
exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

echo "=========================================================="
echo " Starting CodeSkill Backend Bootstrap (Immutable Docker)  "
echo " Architecture: $(uname -m), Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "=========================================================="

# 1. Install Docker & AWS CLI if not present
if command -v dnf &>/dev/null; then
  dnf install -y --allowerasing docker aws-cli jq
  systemctl enable --now docker
elif command -v apt-get &>/dev/null; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y docker.io awscli curl jq
  systemctl enable --now docker
fi

systemctl enable --now amazon-ssm-agent || true

# 2. Retrieve Secure Configuration from AWS Secrets Manager
REGION="${aws_region}"
DB_SECRET_ARN="${db_secret_arn}"
DB_HOST=""
DB_USER=""
DB_PASS=""
DB_NAME=""
DB_PORT="5432"

if [ -n "$DB_SECRET_ARN" ]; then
  SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "$DB_SECRET_ARN" --region "$REGION" --query SecretString --output text)
  if [ -n "$SECRET_JSON" ] && [ "$SECRET_JSON" != "{}" ]; then
    DB_HOST=$(echo "$SECRET_JSON" | jq -r '.host // empty')
    DB_USER=$(echo "$SECRET_JSON" | jq -r '.username // empty')
    DB_PASS=$(echo "$SECRET_JSON" | jq -r '.password // empty')
    DB_NAME=$(echo "$SECRET_JSON" | jq -r '.dbname // empty')
    DB_PORT=$(echo "$SECRET_JSON" | jq -r '.port // "5432"')
  fi
fi

DB_HOST="$${DB_HOST:-${db_host}}"
DB_USER="$${DB_USER:-${db_username}}"
: "$${DB_PASS:?Database password was not returned by Secrets Manager}"
DB_NAME="$${DB_NAME:-${db_name}}"

# 3. Authenticate to Amazon ECR & Pull Backend Image
ECR_REGISTRY="${ecr_registry}"
IMAGE="${backend_image}"

echo "Authenticating Docker with Amazon ECR ($REGION)..."
for i in {1..5}; do
  aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY" && break || sleep 5
done

echo "Pulling immutable image: $IMAGE..."
docker pull "$IMAGE"

# Load PM2.io credentials at boot so secret values never enter Terraform user data.
umask 077
mkdir -p /opt/codeskill
PM2_PARAMETER="${pm2_io_parameter_name}"
printf '' > /opt/codeskill/pm2.env
if [ -n "$PM2_PARAMETER" ]; then
  if PM2_JSON=$(aws ssm get-parameter --name "$PM2_PARAMETER" --region "$REGION" --with-decryption --query Parameter.Value --output text 2>/dev/null); then
    if PM2_ENV=$(printf '%s' "$PM2_JSON" | jq -er '
      select((.PM2_SECRET_KEY | type == "string") and (.PM2_PUBLIC_KEY | type == "string")) |
      select((.PM2_SECRET_KEY | test("^[A-Za-z0-9_-]+$")) and (.PM2_PUBLIC_KEY | test("^[A-Za-z0-9_-]+$"))) |
      "PM2_SECRET_KEY=\(.PM2_SECRET_KEY)\nPM2_PUBLIC_KEY=\(.PM2_PUBLIC_KEY)"
    ' 2>/dev/null); then
      printf '%s\n' "$PM2_ENV" > /opt/codeskill/pm2.env
    else
      echo "Warning: invalid optional PM2 monitoring configuration; continuing without PM2.io credentials." >&2
    fi
  else
    echo "Warning: optional PM2 monitoring parameter unavailable; continuing without PM2.io credentials." >&2
  fi
  unset PM2_JSON PM2_ENV
fi
printf 'PM2_MACHINE_NAME=codeskill-backend-%s\n' "$(hostname)" >> /opt/codeskill/pm2.env
chmod 600 /opt/codeskill/pm2.env

# 4. Create Environment Configuration File
mkdir -p /opt/codeskill
aws ssm get-parameter --name "${backend_env_parameter_name}" --region "$REGION" \
  --with-decryption --query Parameter.Value --output text > /opt/codeskill/backend.env
if ! grep -Eq '^JWT_SECRET=.+$' /opt/codeskill/backend.env; then
  echo "Backend SSM configuration must contain JWT_SECRET" >&2
  exit 1
fi
curl --fail --silent --show-error --location \
  https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
  -o /opt/codeskill/rds-global-bundle.pem
chmod 644 /opt/codeskill/rds-global-bundle.pem
sed '/^DATABASE_URL=/d' "/opt/codeskill/backend.env" > "/opt/codeskill/backend.env.tmp"
mv "/opt/codeskill/backend.env.tmp" "/opt/codeskill/backend.env"
cat << EOF >> /opt/codeskill/backend.env
NODE_ENV=production
PORT=5001
DATABASE_HOST=$DB_HOST
DATABASE_PORT=$DB_PORT
DATABASE_USER=$DB_USER
DATABASE_PASSWORD=$DB_PASS
DATABASE_NAME=$DB_NAME
DATABASE_SSL=true
REDIS_HOST=${redis_host}
REDIS_PORT=6379
REDIS_CLUSTER_MODE=${redis_cluster_mode}
REDIS_TLS=${redis_tls}
NODE_EXTRA_CA_CERTS=/app/certs/rds-global-bundle.pem
CORS_ORIGIN=https://${domain_name}
CLIENT_URL=https://${domain_name}
FRONTEND_URL=https://${domain_name}
CORS_ORIGIN=https://${domain_name}
CODE_EXECUTION_PROVIDER=piston
PISTON_BASE_URL=${piston_base_url}
PISTON_RUNTIME_VERSIONS={"c":"10.2.0","cpp":"10.2.0","java":"15.0.2","python":"3.10.0","javascript":"18.15.0","typescript":"5.0.3"}
PISTON_MAX_CONCURRENT_EXECUTIONS=25
PISTON_GLOBAL_MAX_CONCURRENT=80
PISTON_NODE_MAX_CONCURRENT=25
PISTON_TEST_CASE_CONCURRENCY=4
JUDGE0_BASE_URL=${judge0_base_url}
JUDGE0_MAX_CONCURRENT_EXECUTIONS=20
JUDGE0_GLOBAL_MAX_CONCURRENT=50
JUDGE0_NODE_MAX_CONCURRENT=20
ENABLE_EMBEDDED_JUDGE=true
DB_POOL_MAX=15
DB_POOL_MIN=2
S3_BUCKET_NAME=${s3_bucket_name}
AWS_REGION=$REGION
EOF
chmod 600 /opt/codeskill/backend.env

# 5. Create Systemd Service for CodeSkill Backend
cat << EOF > /etc/systemd/system/codeskill-backend.service
[Unit]
Description=CodeSkill NestJS Backend Container
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker stop codeskill-backend
ExecStartPre=-/usr/bin/docker rm codeskill-backend
ExecStart=/usr/bin/docker run --rm --name codeskill-backend \\
  -p 5001:5001 \\
  --env-file /opt/codeskill/pm2.env \\
  --env-file /opt/codeskill/backend.env \\
  -v /opt/codeskill/rds-global-bundle.pem:/app/certs/rds-global-bundle.pem:ro \\
  $IMAGE
ExecStop=/usr/bin/docker stop -t 30 codeskill-backend

[Install]
WantedBy=multi-user.target
EOF

# 6. Start Backend Service
systemctl daemon-reload
systemctl enable --now codeskill-backend.service

# 7. Verify Readiness Probe before signaling bootstrap completion
echo "Waiting for backend readiness probe (/api/health/ready)..."
READY=false
for i in {1..40}; do
  if curl -sf http://127.0.0.1:5001/api/health/ready >/dev/null 2>&1; then
    READY=true
    echo "Backend readiness probe passed on attempt $i."
    break
  fi
  sleep 3
done

if [ "$READY" != true ]; then echo "Backend readiness probe failed" >&2; exit 1; fi

echo "CodeSkill Backend instance ready at $(date -u +"%Y-%m-%dT%H:%M:%SZ")"

# 7. Register with AWS Cloud Map Private DNS Service
CLOUD_MAP_SERVICE_ID="${backend_service_id}"
if [ -n "$CLOUD_MAP_SERVICE_ID" ]; then
  TOKEN=$(curl -s -S -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || true)
  INSTANCE_ID=$(curl -s -S -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null || true)
  PRIVATE_IP=$(curl -s -S -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4 2>/dev/null || true)
  if [ -n "$INSTANCE_ID" ] && [ -n "$PRIVATE_IP" ]; then
    echo "Registering $INSTANCE_ID ($PRIVATE_IP) with Cloud Map Service $CLOUD_MAP_SERVICE_ID..."
    aws servicediscovery register-instance \
      --service-id "$CLOUD_MAP_SERVICE_ID" \
      --instance-id "$INSTANCE_ID" \
      --attributes AWS_INSTANCE_IPV4="$PRIVATE_IP",AWS_INSTANCE_PORT=5001 \
      --region "$REGION" || true
  fi
fi

cat << 'EOF' > /usr/local/bin/deregister-cloudmap.sh
#!/bin/bash
TOKEN=$(curl -s -S -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || true)
INSTANCE_ID=$(curl -s -S -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null || true)
if [ -n "$INSTANCE_ID" ]; then
  aws servicediscovery deregister-instance --service-id "${backend_service_id}" --instance-id "$INSTANCE_ID" --region "${aws_region}" || true
fi
EOF
chmod +x /usr/local/bin/deregister-cloudmap.sh

cat << 'EOF' > /etc/systemd/system/deregister-cloudmap.service
[Unit]
Description=Deregister Backend Instance from AWS Cloud Map on Shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/deregister-cloudmap.sh
TimeoutSec=20

[Install]
WantedBy=shutdown.target reboot.target halt.target
EOF
systemctl daemon-reload
systemctl enable deregister-cloudmap.service

# 8. Start Grafana Alloy for Observability Metrics
mkdir -p /etc/alloy /var/lib/alloy/data
if grep -Eq '^GRAFANA_CLOUD_API_TOKEN=.+$' /opt/codeskill/backend.env; then
  grep -E '^GRAFANA_CLOUD_API_TOKEN=' /opt/codeskill/backend.env > /etc/alloy/alloy.env
  chmod 600 /etc/alloy/alloy.env
  cat > /etc/alloy/config.alloy << 'EOF'
prometheus.scrape "codeskill_backend" {
  targets = [
    {
      "__address__" = "127.0.0.1:5001",
    },
  ]
  metrics_path = "/api/metrics"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.grafanacloud.receiver]
}

prometheus.remote_write "grafanacloud" {
  endpoint {
    url = "https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push"
    basic_auth {
      username = "3666421"
      password = env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}
EOF

  cat > /etc/systemd/system/codeskill-alloy.service << 'EOF'
[Unit]
Description=Grafana Alloy Observability Agent
After=docker.service codeskill-backend.service
Requires=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker stop codeskill-alloy
ExecStartPre=-/usr/bin/docker rm codeskill-alloy
ExecStart=/usr/bin/docker run --rm --name codeskill-alloy --network host -v /etc/alloy:/etc/alloy -v /var/lib/alloy/data:/var/lib/alloy/data --env-file /etc/alloy/alloy.env grafana/alloy:v1.0.0 run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data
ExecStop=/usr/bin/docker stop -t 15 codeskill-alloy

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable --now codeskill-alloy.service
  echo "Grafana Alloy agent started successfully."
fi
