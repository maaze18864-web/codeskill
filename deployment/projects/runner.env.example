# Trusted control plane. Never send this token to a browser or project container.
PROJECT_RUNNER_TOKEN=replace_with_at_least_32_random_characters
PROJECT_DOCKER_CONTEXT=colima-codeskill-projects
PROJECT_RUNTIME_IMAGE=codeskill-project-runtime:local
PROJECT_RUNNER_PORT=5080
PROJECT_PREVIEW_PORT=5081
PROJECT_PREVIEW_BIND=127.0.0.1
# Local previews get distinct localhost ports; both app loopback aliases are allowed.
# Production previews must use a separate hostname from the application.
PROJECT_APP_ORIGIN=http://127.0.0.1:3000
PROJECT_PREVIEW_ORIGIN=http://localhost:5081
PROJECT_MAX_SESSIONS=2
# Shared admission budget: basic 1024 MB, Next.js/Spring 1536 MB, both 2048 MB.
PROJECT_MEMORY_BUDGET_MB=2048
PROJECT_IDLE_MINUTES=20
PROJECT_MAX_MINUTES=60
