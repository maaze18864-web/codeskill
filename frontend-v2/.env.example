NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Site URL for canonical metadata, sitemap.xml, and robots.txt
# Defaults to https://codeskill.novaserve.cloud in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google login is enabled when a real client ID is configured.
# Use the same OAuth client ID as GOOGLE_CLIENT_ID in the backend.
# Allow http://localhost:3000 as a JavaScript origin in the Google client settings.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

