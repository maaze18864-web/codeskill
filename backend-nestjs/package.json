{
  "name": "backend-nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "node scripts/build.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "typeorm:sync": "node dist/sync-db.js",
    "db:auto-migrate": "ts-node -r tsconfig-paths/register src/database/run-all-auto-migrations.ts",
    "db:migrate": "node dist/database/run-practice-submission-source.js",
    "db:migrate:ts": "ts-node -r tsconfig-paths/register src/database/run-practice-submission-source.ts",
    "db:assessment-proctor-captures:migrate": "ts-node -r tsconfig-paths/register src/database/run-assessment-proctor-captures-migration.ts",
    "db:problem-config-default-language:migrate": "ts-node -r tsconfig-paths/register src/database/run-problem-config-default-language-migration.ts",
    "db:assessment-resume-limit:migrate": "ts-node -r tsconfig-paths/register src/database/run-assessment-resume-limit-migration.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prod:start": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:startup": "node --require reflect-metadata -e \"require('./dist/app.module'); console.log('Compiled application modules load successfully');\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "admin:bootstrap": "ts-node -r tsconfig-paths/register src/create-admins.ts",
    "admin:batch": "ts-node -r tsconfig-paths/register src/create-admin-batch.ts",
    "seed:os-test1": "node -r dotenv/config -r ts-node/register -r tsconfig-paths/register src/seeds/seed-os-test1.ts",
    "seed:local": "node ../scripts/seed_local_platform.js",
    "db:shards:migrate": "ts-node src/database/run-submission-sharding.ts",
    "db:shards:verify": "ts-node src/database/verify-submission-sharding.ts",
    "test:shards:integration": "ts-node test/submission-sharding.integration.ts",
    "test:judges:integration": "ts-node test/judge-resilience.integration.ts",
    "test:judges:live": "ts-node test/judges-live.integration.ts",
    "test:feedback:integration": "ts-node test/submission-feedback.integration.ts",
    "db:bugs:migrate": "ts-node -r tsconfig-paths/register src/database/run-bug-reports-migration.ts",
    "db:learning:migrate": "ts-node -r tsconfig-paths/register src/database/run-learning-module-migration.ts",
    "seed:learning": "ts-node -r tsconfig-paths/register src/seeds/seed-learning-module.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-ses": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@axiomhq/pino": "^2.0.0",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "@react-pdf/renderer": "^4.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "17.4.1",
    "google-auth-library": "^10.9.0",
    "graphql": "^16.14.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nest-winston": "^1.10.2",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
