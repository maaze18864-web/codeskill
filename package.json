{
  "name": "codeskill-platform",
  "version": "1.0.0",
  "description": "Root package for managing CodeSkill platform builds",
  "private": true,
  "scripts": {
    "local:init": "node scripts/init_local_dev.js",
    "local:services:up": "node scripts/local_compose.js up --detach --wait",
    "local:services:down": "node scripts/local_compose.js down",
    "local:services:logs": "node scripts/local_compose.js logs --follow",
    "local:db:sync": "node scripts/sync_local_database.js",
    "local:accounts": "node scripts/seed_local_accounts.js",
    "local:backend": "node scripts/start_local_backend.js",
    "local:test": "npm test --prefix backend-nestjs -- --runInBand",
    "install:backend": "npm install --prefix backend-nestjs",
    "install:frontend": "npm install --prefix frontend-v2",
    "install:all": "npm run install:backend && npm run install:frontend",
    "build:backend": "npm run build --prefix backend-nestjs",
    "build:frontend": "npm run build --prefix frontend-v2",
    "build": "npm run install:all && npm run build:backend && npm run build:frontend",
    "admin:bootstrap": "npm run --prefix backend-nestjs admin:bootstrap --",
    "admin:batch": "npm run --prefix backend-nestjs admin:batch",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js --update-env"
  }
}
